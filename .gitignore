# Captured content NEVER enters git. The framework is shareable; what it
# captures is not. Enforced structurally by scripts/pre-commit-guard.sh,
# installed by `ma init`.
data/
*.db
*.sqlite
*.sqlite3

# Machine-local configuration (written by `ma doctor --write`)
config.local.json

# Secrets
.env
*.env

# Product-discovery project state is work product — mined evidence, the
# assumption ledger, and generated artifacts.
#
# Projects are scaffolded OUTSIDE this repo by design, so these patterns are a
# backstop for a project accidentally created inside it. They are anchored to the
# repo root so they cannot swallow framework files that share a name:
# product-discovery/protocol/assumptions.md is a protocol document, and
# product-discovery/project-template/ holds the empty scaffold new-project.sh
# copies. Both must ship.
/evidence/
/assumptions.md
/artifacts/

# Exports may contain captured content
exports/
*.export.json
*.export.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Editor / OS
.DS_Store
.idea/
*.swp
