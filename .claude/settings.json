{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/session-start.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "git fetch -q; git remote get-url origin; git status -sb; git log --oneline -3"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/session-end.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
