// Smallest safe policy for a personal tailnet.
// "Your devices can reach your devices." A machine shared in from another tailnet is
// NOT a member, so it stays isolated. Only add tag: rules after you have ACTUALLY applied
// tags in the admin console — a device whose NAME looks like a tag is not tagged, and a
// rule that matches nothing yields an empty packet filter (= deny-all; pings still work).
{
  "acls": [
    { "action": "accept", "src": ["autogroup:member"], "dst": ["autogroup:self:*"] }
  ],
  "ssh": [
    // Only meaningful with the standalone daemon build; the App Store build cannot run Tailscale SSH.
    // Prove it by connecting once BEFORE you gate anything else on it.
    { "action": "check", "src": ["autogroup:member"], "dst": ["autogroup:self"], "users": ["autogroup:nonroot"] }
  ]
}
// Also, in the console: disable key expiry on every always-on node (servers, NAS).
