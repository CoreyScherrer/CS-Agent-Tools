# Copy to the service's env file. chmod 600, owned by the service user.
# Every process (web + scheduler + background jobs) reads THIS file and no other.

# --- Slack (Phase 1) ---
SLACK_BOT_TOKEN=xoxb-paste-here
SLACK_SIGNING_SECRET=paste-here
SLACK_CHANNEL_ASSISTANT=C0000000000
SLACK_CHANNEL_SITES=C0000000000
SLACK_ALLOWED_USERS=U0000000000          # comma-separated; empty = nobody
BOT_DISABLED=0                           # 1 = kill switch, still returns 200 to Slack

# --- Model (Phase 3) ---
ANTHROPIC_API_KEY=paste-here
ANTHROPIC_MODEL=                         # leave blank = the current mid-tier model in code
DAILY_COST_CAP_USD=2.00
RATE_LIMIT_PER_MIN=10

# --- State ---
STATE_DIR=/var/lib/slack-assistant       # owned by the service user; audit.sqlite lives here
LOG_DIR=/var/log/slack-assistant

# --- Google (Phase 5, optional) ---
GOOGLE_CREDENTIALS_PATH=/etc/slack-assistant/google-credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=/etc/slack-assistant/calendar-token.json
GMAIL_TOKEN_PATH=/etc/slack-assistant/gmail-token.json

# --- Optional ---
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
MEMORY_CLI=python3 -m ma                 # portable memory archive from this repo
